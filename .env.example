# --- Data source -------------------------------------------------------------
# "demo"     : in-memory demo tenant data, no external services needed (default)
# "supabase" : live Supabase project (requires the three SUPABASE_* vars below)
DATA_SOURCE=demo

# --- Supabase ----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by the booking/inbox API routes (RPC calls, writes).
SUPABASE_SERVICE_ROLE_KEY=

# --- Tenant resolution -------------------------------------------------------
# Domain to assume when the request host is localhost / an unknown host.
# Must match a row in hotel_domains (or a demo hotel domain in demo mode).
DEFAULT_TENANT_DOMAIN=demo.staybook.local

# Apex domain for free tenant subdomains ({slug}.<apex>). Requires a wildcard
# domain + DNS on the hosting platform. Used by the onboarding wizard when
# persisting new tenants (supabase mode).
PLATFORM_APEX_DOMAIN=

# --- AI generation (onboarding wizard) ----------------------------------------
# Optional: enables Claude copywriting (ko/en/ja) during onboarding.
# Without it the wizard falls back to extracted content + preset composition.
ANTHROPIC_API_KEY=
ONBOARDING_MODEL=claude-sonnet-5
